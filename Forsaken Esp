local originalTransparencies = {}

-- Survivor, Tool, & Workspace.Map.Ingame 内の各種オブジェクトハイライト処理
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local map = workspace:FindFirstChild("Map")
            if not map then return end
            local ingame = map:FindFirstChild("Ingame")
            if not ingame then return end
            
            local innerMap = ingame:FindFirstChild("Map")
            if innerMap then
                local gearsTest = innerMap:FindFirstChild("GearsTest")
                if gearsTest then
                    for _, child in ipairs(gearsTest:GetChildren()) do
                        if child:IsA("Model") and child.Name == "Gear" then
                            local details = child:FindFirstChild("Details")
                            if details and details:IsA("Model") then
                                local defaultPart = details:FindFirstChild("default")
                                if defaultPart and defaultPart:IsA("BasePart") then
                                    local hl = defaultPart:FindFirstChild("Gear_Highlight")
                                    if _G.Settings.ShowGearHighlight then
                                        if not hl then
                                            hl = Instance.new("Highlight")
                                            hl.Name = "Gear_Highlight"
                                            hl.Adornee = defaultPart
                                            hl.FillTransparency = 0.4
                                            hl.OutlineTransparency = 0
                                            hl.Parent = defaultPart
                                        end
                                        hl.Enabled = true
                                        hl.FillColor = _G.Colors.ShowGearHighlight
                                        hl.OutlineColor = _G.Colors.ShowGearHighlight
                                    else
                                        if hl then hl.Enabled = false end
                                    end
                                end
                            end
                        end
                    end
                end

                for _, obj in ipairs(innerMap:GetChildren()) do
                    if obj:IsA("Tool") then
                        for _, desc in ipairs(obj:GetDescendants()) do
                            if desc:IsA("MeshPart") then
                                local hl = desc:FindFirstChild("Tool_Highlight")
                                if _G.Settings.ShowToolHighlight then
                                    if not hl then
                                        hl = Instance.new("Highlight")
                                        hl.Name = "Tool_Highlight"
                                        hl.Adornee = desc
                                        hl.FillTransparency = 0.4
                                        hl.OutlineTransparency = 0
                                        hl.Parent = desc
                                    end
                                    hl.Enabled = true
                                    hl.FillColor = _G.Colors.ShowToolHighlight
                                    hl.OutlineColor = _G.Colors.ShowToolHighlight
                                else
                                    if hl then hl.Enabled = false end
                                end
                            end
                        end
                    end
                end
            end

            for _, child in ipairs(ingame:GetChildren()) do
                if child.Name ~= "Map" then
                    if string.sub(child.Name, -7) == "Shadows" then
                        for _, part in ipairs(child:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name == "Shadow" then
                                if not originalTransparencies[part] then
                                    originalTransparencies[part] = part.Transparency
                                end

                                local hl = part:FindFirstChild("KillerObject_Highlight")
                                if _G.Settings.ShowKillerObjectHighlight then
                                    part.Transparency = 0
                                    if not hl then
                                        hl = Instance.new("Highlight")
                                        hl.Name = "KillerObject_Highlight"
                                        hl.Adornee = part
                                        hl.FillTransparency = 0.4
                                        hl.OutlineTransparency = 0
                                        hl.Parent = part
                                    end
                                    hl.Enabled = true
                                    hl.FillColor = _G.Colors.ShowKillerObjectHighlight
                                    hl.OutlineColor = _G.Colors.ShowKillerObjectHighlight
                                else
                                    if hl then hl.Enabled = false end
                                    part.Transparency = originalTransparencies[part] or 1
                                end
                            end
                        end
                    elseif child:IsA("Model") then
                        local hl = child:FindFirstChild("KillerObject_Highlight")
                        if _G.Settings.ShowKillerObjectHighlight then
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "KillerObject_Highlight"
                                hl.Adornee = child
                                hl.FillTransparency = 0.4
                                hl.OutlineTransparency = 0
                                hl.Parent = child
                            end
                            hl.Enabled = true
                            hl.FillColor = _G.Colors.ShowKillerObjectHighlight
                            hl.OutlineColor = _G.Colors.ShowKillerObjectHighlight
                        else
                            if hl then hl.Enabled = false end
                        end
                    end
                end
            end
        end)
    end
end)

-- プレイヤーESPループ
task.spawn(function()
    while task.wait() do
        for _, v in ipairs(Players:GetPlayers()) do
            pcall(function()
                local esp = getESP(v)
                if v ~= plr and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") then
                    local hrp = v.Character.HumanoidRootPart
                    local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    
                    if onScreen then
                        local head = v.Character:FindFirstChild("Head")
                        local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or screenPos
                        local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local boxHeight = math.abs(headPos.Y - legPos.Y)
                        local boxWidth = boxHeight / 1.5
                        
                        if _G.Settings.ShowBoxes then
                            esp.Box.Size = Vector2.new(boxWidth, boxHeight)
                            esp.Box.Position = Vector2.new(screenPos.X - boxWidth / 2, screenPos.Y - boxHeight / 2)
                            esp.Box.Color = _G.Colors.ShowBoxes
                            esp.Box.Visible = true
                        else
                            esp.Box.Visible = false
                        end
                        
                        local vHolder = Holder:FindFirstChild(v.Name)
                        if vHolder then
                            local nameTag = vHolder:FindFirstChild(v.Name .. "NameTag")
                            if nameTag then
                                nameTag.Enabled = _G.Settings.ShowNames
                                local targetTag = nameTag:FindFirstChild("TargetTag")
                                if targetTag and _G.Settings.ShowNames then
                                    updateTagText(v, targetTag)
                                end
                            end
                        end
                    else
                        esp.Box.Visible = false
                        local vHolder = Holder:FindFirstChild(v.Name)
                        if vHolder and vHolder:FindFirstChild(v.Name .. "NameTag") then
                            vHolder[v.Name .. "NameTag"].Enabled = false
                        end
                    end
                else
                    esp.Box.Visible = false
                end
            end)
        end
    end
end)
