task.spawn(function()
    local killerFolderContainer = workspace:WaitForChild("Players", 5) and workspace.Players:WaitForChild("Killers", 5)
    local function setupKillerModel(model)
        if not model:IsA("Model") then return end
        local usernameAttr = model:GetAttribute("Username")
        if usernameAttr and usernameAttr == plr.Name then
            if model:FindFirstChild("KillerESP_Highlight") then model.KillerESP_Highlight:Destroy() end
            return
        end
        if model:FindFirstChild("KillerESP_Highlight") then model.KillerESP_Highlight:Destroy() end
        local highlight = Instance.new("Highlight")
        highlight.Name = "KillerESP_Highlight"
        highlight.Adornee = model
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = model
    end

    if killerFolderContainer then
        for _, child in ipairs(killerFolderContainer:GetChildren()) do setupKillerModel(child) end
        killerFolderContainer.ChildAdded:Connect(function(child) task.wait(0.1) setupKillerModel(child) end)
    end

    while task.wait(0.2) do
        if killerFolderContainer then
            for _, child in ipairs(killerFolderContainer:GetChildren()) do
                if child:IsA("Model") then
                    local usernameAttr = child:GetAttribute("Username")
                    if usernameAttr and usernameAttr == plr.Name then
                        if child:FindFirstChild("KillerESP_Highlight") then child.KillerESP_Highlight:Destroy() end
                    else
                        local hl = child:FindFirstChild("KillerESP_Highlight")
                        if hl then
                            hl.Enabled = _G.Settings.ShowKillerHighlight
                            hl.FillColor = _G.Colors.ShowKillerHighlight
                            hl.OutlineColor = _G.Colors.ShowKillerHighlight
                        else
                            setupKillerModel(child)
                        end
                    end
                end
            end
        else
            local p = workspace:FindFirstChild("Players")
            if p then killerFolderContainer = p:FindFirstChild("Killers") end
        end
    end
end)

