local function createFovSlider(parentCol, posY)
    local SliderFrame = Instance.new("Frame", parentCol)
    SliderFrame.Size = UDim2.new(1, 0, 0, 24)
    SliderFrame.Position = UDim2.new(0, 0, 0, posY)
    SliderFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    SliderFrame.BorderSizePixel = 0

    local sfCorner = Instance.new("UICorner", SliderFrame)
    sfCorner.CornerRadius = UDim.new(0, 4)
    local sfStroke = Instance.new("UIStroke", SliderFrame)
    sfStroke.Thickness = 1
    sfStroke.Color = Color3.fromRGB(80, 70, 100)
    sfStroke.Transparency = 0.5

    local FillBar = Instance.new("Frame", SliderFrame)
    FillBar.Size = UDim2.new(0, 0, 1, 0)
    FillBar.BackgroundColor3 = Color3.fromRGB(60, 50, 90)
    FillBar.BorderSizePixel = 0
    local fbCorner = Instance.new("UICorner", FillBar)
    fbCorner.CornerRadius = UDim.new(0, 4)

    local Label = Instance.new("TextLabel", SliderFrame)
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 10
    Label.TextColor3 = Color3.fromRGB(255, 220, 100)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local padding = Instance.new("UIPadding", Label)
    padding.PaddingLeft = UDim.new(0, 6)

    local function updateSlider(value)
        value = math.clamp(value, 70, 120)
        _G.Settings.FOV = math.floor(value)
        
        Label.Text = "FOV: " .. tostring(_G.Settings.FOV)
        local percent = (_G.Settings.FOV - 70) / (120 - 70)
        FillBar.Size = UDim2.new(percent, 0, 1, 0)
    end

    SliderFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isSliderDragging = true
            local mousePos = UserInputService:GetMouseLocation()
            local relX = mousePos.X - SliderFrame.AbsolutePosition.X
            local percent = math.clamp(relX / SliderFrame.AbsoluteSize.X, 0, 1)
            updateSlider(70 + (percent * 50))
            saveConfig()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isSliderDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isSliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mousePos = UserInputService:GetMouseLocation()
            local relX = mousePos.X - SliderFrame.AbsolutePosition.X
            local percent = math.clamp(relX / SliderFrame.AbsoluteSize.X, 0, 1)
            updateSlider(70 + (percent * 50))
            saveConfig()
        end
    end)

    updateSlider(_G.Settings.FOV)
end

