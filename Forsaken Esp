local function createButton(parentCol, text, settingKey, posY, hasColor)
    local btnWidth = hasColor and 130 or 175
    local btn = Instance.new("TextButton", parentCol)
    btn.Size = UDim2.new(0, btnWidth, 0, 28)
    btn.Position = UDim2.new(0, 0, 0, posY)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local padding = Instance.new("UIPadding", btn)
    padding.PaddingLeft = UDim.new(0, 6)

    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 4)
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Thickness = 1

    local ColorIndicator, indStroke
    if hasColor then
        ColorIndicator = Instance.new("TextButton", parentCol)
        ColorIndicator.Size = UDim2.new(0, 40, 0, 28)
        ColorIndicator.Position = UDim2.new(0, 135, 0, posY)
        ColorIndicator.Text = "CLR"
        ColorIndicator.Font = Enum.Font.GothamBold
        ColorIndicator.TextSize = 9
        ColorIndicator.TextColor3 = Color3.fromRGB(20, 20, 20)
        ColorIndicator.BorderSizePixel = 0
        
        local indCorner = Instance.new("UICorner", ColorIndicator)
        indCorner.CornerRadius = UDim.new(0, 4)
        indStroke = Instance.new("UIStroke", ColorIndicator)
        indStroke.Thickness = 1
    end

    local function updateDisplay()
        if _G.Settings[settingKey] then
            btn.BackgroundColor3 = Color3.fromRGB(40, 80, 50)
            btn.TextColor3 = Color3.fromRGB(120, 255, 150)
            btn.Text = "[ON] " .. text
        else
            btn.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
            btn.TextColor3 = Color3.fromRGB(160, 160, 175)
            btn.Text = "[OFF] " .. text
        end

        if hasColor then
            if currentConfigTarget == settingKey then
                btnStroke.Color = Color3.fromRGB(255, 170, 50)
                btnStroke.Transparency = 0.1
                indStroke.Color = Color3.fromRGB(255, 170, 50)
                indStroke.Transparency = 0.1
            else
                btnStroke.Color = Color3.fromRGB(60, 60, 75)
                btnStroke.Transparency = 0.6
                indStroke.Color = Color3.fromRGB(50, 50, 65)
                indStroke.Transparency = 0.4
            end
            ColorIndicator.BackgroundColor3 = _G.Colors[settingKey]
        else
            if currentConfigTarget == settingKey then
                btnStroke.Color = Color3.fromRGB(255, 170, 50)
                btnStroke.Transparency = 0.1
            else
                btnStroke.Color = Color3.fromRGB(60, 60, 75)
                btnStroke.Transparency = 0.6
            end
        end
    end
    
    btn.MouseButton1Click:Connect(function()
        _G.Settings[settingKey] = not _G.Settings[settingKey]
        currentConfigTarget = settingKey
        updateDisplay()
        saveConfig()
    end)

    if hasColor then
        ColorIndicator.MouseButton1Click:Connect(function()
            currentConfigTarget = settingKey
            updateDisplay()
        end)
    end
    
    task.spawn(function()
        while task.wait(0.2) do updateDisplay() end
    end)
    updateDisplay()
end

