local function createColorSlider(parentCol, colorChannel, posY)
    local btn = Instance.new("TextButton", parentCol)
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.Position = UDim2.new(0, 0, 0, posY)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local padding = Instance.new("UIPadding", btn)
    padding.PaddingLeft = UDim.new(0, 6)
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 4)
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(60, 60, 80)
    btnStroke.Transparency = 0.5

    local function updateColorDisplay()
        if not _G.Colors[currentConfigTarget] then return end
        local activeColor = _G.Colors[currentConfigTarget]
        local r, g, b = math.floor(activeColor.R * 255), math.floor(activeColor.G * 255), math.floor(activeColor.B * 255)
        
        if colorChannel == "R" then
            btn.Text = "[R] VAL: " .. r
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
        elseif colorChannel == "G" then
            btn.Text = "[G] VAL: " .. g
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
        elseif colorChannel == "B" then
            btn.Text = "[B] VAL: " .. b
            btn.TextColor3 = Color3.fromRGB(100, 100, 255)
        end
    end

    btn.MouseButton1Click:Connect(function()
        if not _G.Colors[currentConfigTarget] then return end
        local activeColor = _G.Colors[currentConfigTarget]
        local r, g, b = math.floor(activeColor.R * 255), math.floor(activeColor.G * 255), math.floor(activeColor.B * 255)
        if colorChannel == "R" then r = (r + 25) > 255 and 0 or (r + 25)
        elseif colorChannel == "G" then g = (g + 25) > 255 and 0 or (g + 25)
        elseif colorChannel == "B" then b = (b + 25) > 255 and 0 or (b + 25) end
        _G.Colors[currentConfigTarget] = Color3.fromRGB(r, g, b)
        updateColorDisplay()
        saveConfig()
    end)

    task.spawn(function() while task.wait(0.1) do updateColorDisplay() end end)
    updateColorDisplay()
end

