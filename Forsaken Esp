local function saveConfig()
    local config = {
        ShowNames = _G.ShowNames,
        ShowBoxes = _G.ShowBoxes,
        ShowTracers = _G.ShowTracers,
        ShowSkeletons = _G.ShowSkeletons,
        ShowKillerHighlight = _G.ShowKillerHighlight,
        ShowGeneratorHighlight = _G.ShowGeneratorHighlight,
        ShowGearHighlight = _G.ShowGearHighlight,
        FullBright = _G.FullBright,
        Colors = {
            Names = {math.floor(_G.Colors.ShowNames.R*255), math.floor(_G.Colors.ShowNames.G*255), math.floor(_G.Colors.ShowNames.B*255)},
            Boxes = {math.floor(_G.Colors.ShowBoxes.R*255), math.floor(_G.Colors.ShowBoxes.G*255), math.floor(_G.Colors.ShowBoxes.B*255)},
            Tracers = {math.floor(_G.Colors.ShowTracers.R*255), math.floor(_G.Colors.ShowTracers.G*255), math.floor(_G.Colors.ShowTracers.B*255)},
            Skeletons = {math.floor(_G.Colors.ShowSkeletons.R*255), math.floor(_G.Colors.ShowSkeletons.G*255), math.floor(_G.Colors.ShowSkeletons.B*255)},
            KillerHighlight = {math.floor(_G.Colors.ShowKillerHighlight.R*255), math.floor(_G.Colors.ShowKillerHighlight.G*255), math.floor(_G.Colors.ShowKillerHighlight.B*255)},
            GeneratorHighlight = {math.floor(_G.Colors.ShowGeneratorHighlight.R*255), math.floor(_G.Colors.ShowGeneratorHighlight.G*255), math.floor(_G.Colors.ShowGeneratorHighlight.B*255)},
            GearHighlight = {math.floor(_G.Colors.ShowGearHighlight.R*255), math.floor(_G.Colors.ShowGearHighlight.G*255), math.floor(_G.Colors.ShowGearHighlight.B*255)}
        }
    }
    pcall(function()
        writefile(fileName, HttpService:JSONEncode(config))
    end)
end

-- ロード機能
local function loadConfig()
    pcall(function()
        if isfile(fileName) then
            local data = HttpService:JSONDecode(readfile(fileName))
            if data.ShowNames ~= nil then _G.ShowNames = data.ShowNames end
            if data.ShowBoxes ~= nil then _G.ShowBoxes = data.ShowBoxes end
            if data.ShowTracers ~= nil then _G.ShowTracers = data.ShowTracers end
            if data.ShowSkeletons ~= nil then _G.ShowSkeletons = data.ShowSkeletons end
            if data.ShowKillerHighlight ~= nil then _G.ShowKillerHighlight = data.ShowKillerHighlight end
            if data.ShowGeneratorHighlight ~= nil then _G.ShowGeneratorHighlight = data.ShowGeneratorHighlight end
            if data.ShowGearHighlight ~= nil then _G.ShowGearHighlight = data.ShowGearHighlight end
            if data.FullBright ~= nil then _G.FullBright = data.FullBright end
            
            if data.Colors then
                if data.Colors.Names then _G.Colors.ShowNames = Color3.fromRGB(unpack(data.Colors.Names)) end
                if data.Colors.Boxes then _G.Colors.ShowBoxes = Color3.fromRGB(unpack(data.Colors.Boxes)) end
                if data.Colors.Tracers then _G.Colors.ShowTracers = Color3.fromRGB(unpack(data.Colors.Tracers)) end
                if data.Colors.Skeletons then _G.Colors.ShowSkeletons = Color3.fromRGB(unpack(data.Colors.Skeletons)) end
                if data.Colors.KillerHighlight then _G.Colors.ShowKillerHighlight = Color3.fromRGB(unpack(data.Colors.KillerHighlight)) end
                if data.Colors.GeneratorHighlight then _G.Colors.ShowGeneratorHighlight = Color3.fromRGB(unpack(data.Colors.GeneratorHighlight)) end
                if data.Colors.GearHighlight then _G.Colors.ShowGearHighlight = Color3.fromRGB(unpack(data.Colors.GearHighlight)) end
            end
        end
    end)
end

